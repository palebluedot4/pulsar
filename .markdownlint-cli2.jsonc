// markdownlint-cli2 runs the same engine as the markdownlint editor extension,
// so the editor and the gate report the same problems. Prettier formats;
// markdownlint lints what formatting cannot decide. The rules themselves are
// in .markdownlint.jsonc.
{
  "globs": ["**/*.md"],
  // Skip what git ignores, node_modules above all.
  "gitignore": true,
  // CLAUDE.md is a single import line, as Claude Code documents it. LICENSE
  // is the license's own plain text, which editors sometimes treat as Markdown.
  "ignores": ["CLAUDE.md", "LICENSE"],
}
